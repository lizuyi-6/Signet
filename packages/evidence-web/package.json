{
  "name": "@signet/evidence-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-side C2PA evidence collector for Signet. Mirrors @signet/evidence but uses @contentauth/c2pa-web (WASM) instead of the Node native binding, so it runs in a content script / offscreen document.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@signet/core": "workspace:*",
    "@signet/evidence": "workspace:*",
    "@contentauth/c2pa-web": "^0.13.4"
  },
  "devDependencies": {
    "@signet/trust-engine": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
